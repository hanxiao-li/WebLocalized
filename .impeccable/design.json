  "narrative": {
    "northStar": "Reference-led cinematic game localization",
    "overview": "用户批准的 Wix wh-1204 / PROZI marketing 模板是视觉权威：深色游戏世界影像、大尺度字形、胶囊导航与蓝色区块共同建立气氛。当前系统延续已有方向；不把演示品牌或演示项目视为真实客户证据。没有已批准的独立页面 comp。\n\n公开页面采用宽幅影像和充足留白，阅读页面以正文清晰为先，后台延续现有 Radix Themes 操作界面。滚动入场服务于阅读节奏，减少动态效果偏好优先于演出。",
    "keyCharacteristics": [
      "深墨、米白和明蓝形成大面积色块节奏。",
      "粗体标题、矩形媒体与圆润操作形成对照。",
      "内容默认可见，动态效果渐进增强。"
    ],
    "rules": [
      {
        "name": "The Reference Color Rule",
        "body": "保留参考模板批准的蓝色到米白渐变，不将其替换为无依据的通用卡片底色。",
        "section": "colors"
      },
      {
        "name": "The Readable First Rule",
        "body": "未启用观察器时不隐藏内容；减少动态效果及打印模式禁用入场隐藏与位移。",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** 延续用户批准的 Wix 参考与既有深墨、米白、明蓝视觉方向。",
      "**Do** 保留清晰的键盘焦点、视频控制和减少动态效果支持。",
      "**Do** 将演示名称、项目和素材作为可编辑示例处理。"
    ],
    "donts": [
      "**Don't** 虚构客户、成果数据或推荐语。",
      "**Don't** 把手机图片固定成桌面 HTML 高度。",
      "**Don't** 为装饰效果牺牲正文可读性或媒体播放控制。"
    ]
  }
